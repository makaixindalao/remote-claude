# rcweb 的配置。复制成同目录的 .env 再改（.env 已被 .gitignore 排除，密码不会进仓库）：
#   cp server/.env.example server/.env
# rcweb deploy 会把它连同从 remote-claude config 推导出的几项一起写到 VPS 的 /etc/rcweb.env。

# 登录密码（必填）
RCWEB_PASSWORD=change-me

# 监听地址。127.0.0.1：只能经 Tailscale / SSH 隧道访问；0.0.0.0：直接开 http://<VPS IP>:7681
# （明文 HTTP，rcweb deploy 会顺带放行 VPS 上的 ufw / firewalld）。deploy.sh 按 DEPLOY_WEB_PUBLIC 改这一项
RCWEB_LISTEN=127.0.0.1:7681

# 以下几项 rcweb deploy 会按 ~/.config/remote-claude/config 自动填，一般不用写；
# 写了就以这里为准
# RCWEB_ROOT=/root                 项目根目录（= RC_REMOTE_ROOT）
# RCWEB_PROJECTS=myapp,mytool      项目列表（= RC_PROJECTS + RC_SESSION_PROJECTS）
# RCWEB_CLAUDE_DIR=/root/.claude
# RCWEB_CLAUDE_BIN=/usr/local/bin/claude

# 设置页打开「用 reclaude 代替 claude」后起的程序。默认在 PATH 里找 reclaude，找不到再看 ~/.local/bin/reclaude
# RCWEB_RECLAUDE_BIN=/root/.local/bin/reclaude

# Codex / Grok：默认在 PATH 里找 codex、grok（PATH 取自 VPS 的登录 shell），数据目录跟 CLI 自己的规则
# （CODEX_HOME / GROK_HOME，否则 ~/.codex、~/.grok）。没装的在页面上就不出现
# RCWEB_CODEX_BIN=/usr/local/bin/codex
# RCWEB_CODEX_DIR=/root/.codex
# RCWEB_GROK_BIN=/root/.grok/bin/grok
# RCWEB_GROK_DIR=/root/.grok

# 可选：参与登录 cookie 的签名，换一个值 = 所有浏览器重新登录（改密码也有同样效果）
# RCWEB_SECRET=

# 网页终端新建 tmux 会话时，像 scc 一样补 --dangerously-skip-permissions（1/0）
# RCWEB_TERM_SKIP_PERMISSIONS=1

# 网页对话没人看、也没在干活时，多久后结束 claude 进程（会话记录还在，随时能续）
# RCWEB_CHAT_IDLE=12h
