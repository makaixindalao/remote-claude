# deploy.sh 的部署信息。复制成同目录的 .env 再填（.env 已被 .gitignore 排除）：
#   cp .env.example .env
# 填了 DEPLOY_TARGET，./deploy.sh 就按这里一键部署，全程不确认；
# 要交互式输入、逐步确认，用 ./deploy.sh --no-env。
# 命令行参数、已 export 的同名环境变量优先于这里。

# 部署目标：用户@主机[:端口]。用户默认 root，端口默认 22
DEPLOY_TARGET=

# ~/.ssh/config 里的 Host 别名。留空：沿用已指向这台机器的别名，没有就新建 vps-<IP 第一段>
DEPLOY_ALIAS=

# 新建 Host 块时用的私钥，不存在就生成（ed25519、无口令）。已有 Host 块时用它自己配的那把
DEPLOY_KEY=~/.ssh/id_ed25519

# 是否部署网页端 rcweb（1/0）。rcweb 自己的登录密码等配置在 server/.env
DEPLOY_WEB=1

# 网页端直接开在公网 IP 上（1/0）。1：监听 0.0.0.0，部署完浏览器开 http://<VPS IP>:7681，
# 明文 HTTP、登录密码至少 12 位；0：只监听 127.0.0.1，走 rcweb tunnel / Tailscale。等同 --no-public
DEPLOY_WEB_PUBLIC=1
